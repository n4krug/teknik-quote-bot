# Discord bot token (Developer Portal > Applications > Bot > Token)
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID (Developer Portal > Applications > General Information)
DISCORD_CLIENT_ID=your-client-id-here

# Optional: register slash commands to one guild instantly instead of globally (up to 1h)
GUILD_ID=

# Optional: channel the /quote command uses when no channel argument is given.
# If empty, the channel argument becomes required.
QUOTE_CHANNEL_ID=

# How many of the most recent messages to consider (max 5000)
QUOTE_HISTORY_LIMIT=500

# Skip messages sent by bots (true/false)
QUOTE_EXCLUDE_BOTS=true

# Skip messages newer than this many seconds (0 = no age filter)
QUOTE_MIN_AGE_SECONDS=0

# Voice used by `npm run speak` (any Microsoft Edge "ShortName")
TTS_VOICE=en-US-GuyNeural

# Port the running bot listens on for `npm run speak` (loopback only)
SPEAK_PORT=7433
